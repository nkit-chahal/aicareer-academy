  "raw_html": "<main id=\"main-content\"><div><section class=\"py-24 lg:py-32 bg-white dark:bg-background\"><div class=\"max-w-4xl mx-auto px-4 sm:px-6 text-center\"><div style=\"opacity:0;will-change:opacity,transform;transform:translateY(24px)\"><p class=\"text-xs font-semibold uppercase tracking-widest text-muted-foreground mb-5\">Contact</p><h1 class=\"text-4xl sm:text-5xl lg:text-6xl font-bold text-foreground leading-tight\">Talk to the <span class=\"brand\">Right Team</span></h1><p class=\"mt-6 text-[15px] sm:text-base text-muted-foreground max-w-xl mx-auto leading-relaxed\">Whether you are exploring programs, evaluating corporate training, or building a hiring pipeline — we are here with direct answers.</p><div class=\"mt-10 flex flex-wrap items-center justify-center gap-4\"><a class=\"px-6 py-3 rounded-xl bg-foreground text-background text-sm font-semibold hover:opacity-85 transition-opacity\" href=\"https://calendly.com/schoolofcoreai\" rel=\"noopener noreferrer\" target=\"_blank\">Book a Call</a><a class=\"px-6 py-3 rounded-xl border border-border text-foreground text-sm font-semibold hover:bg-muted/40 transition-colors\" href=\"https://wa.me/919691440998\" rel=\"noopener noreferrer\" target=\"_blank\">WhatsApp Us</a></div></div></div></section><section class=\"py-20 lg:py-28 bg-slate-50/60 dark:bg-slate-900/20\"><div class=\"max-w-2xl mx-auto px-4 sm:px-6\"><div class=\"text-center mb-12\" style=\"opacity:0;transform:translateY(20px)\"><p class=\"text-xs font-semibold uppercase tracking-widest text-muted-foreground mb-4\">Get in Touch</p><h2 class=\"text-3xl sm:text-4xl font-bold text-foreground\">Send Us a <span class=\"brand\">Message</span></h2><p class=\"mt-4 text-[14px] text-muted-foreground\">Fill in the form below. We respond within one business day.</p></div><div class=\"p-8 rounded-2xl border border-border bg-card\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"container mx-auto px-3 py-2\"><form class=\"space-y-3 w-full\"><div><label class=\"block text-sm font-medium text-gray-700\" for=\"name\">Name <span class=\"text-red-500\">*</span></label><input class=\"w-full border border-gray-200 px-3 py-2 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-[#8C263C]/40 focus:border-[#8C263C]/40 transition\" id=\"name\" name=\"name\" required=\"\" type=\"text\"/></div><div><label class=\"block text-sm font-medium text-gray-700\" for=\"phone\">Phone No. <span class=\"text-red-500\">*</span></label><input class=\"w-full border border-gray-200 px-3 py-2 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-[#8C263C]/40 focus:border-[#8C263C]/40 transition\" id=\"phone\" name=\"phone\" required=\"\" type=\"text\"/></div><div><label class=\"block text-sm font-medium text-gray-700\" for=\"email\">Email ID <span class=\"text-red-500\">*</span></label><input class=\"w-full border border-gray-200 px-3 py-2 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-[#8C263C]/40 focus:border-[#8C263C]/40 transition\" id=\"email\" name=\"email\" required=\"\" type=\"email\"/></div><div><label class=\"block text-sm font-medium text-gray-700\" for=\"experience\">Experience <span class=\"text-red-500\">*</span></label><input class=\"w-full border border-gray-200 px-3 py-2 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-[#8C263C]/40 focus:border-[#8C263C]/40 transition\" id=\"experience\" name=\"experience\" required=\"\" type=\"text\"/></div><div class=\"hidden\"><label class=\"block text-base font-medium\" for=\"requested-for\">Requested For <span class=\"text-red-500\">*</span></label><input class=\"w-full border p-2 rounded\" id=\"requested-for\" name=\"requested-for\" readonly=\"\" required=\"\" type=\"text\" value=\"Contact Us\"/></div><input name=\"lead-source\" readonly=\"\" type=\"hidden\" value=\"Direct / Unknown\"/><input name=\"landing-page\" readonly=\"\" type=\"hidden\" value=\"\"/><input name=\"referrer\" readonly=\"\" type=\"hidden\" value=\"\"/><input name=\"utm-source\" readonly=\"\" type=\"hidden\" value=\"\"/><input name=\"utm-medium\" readonly=\"\" type=\"hidden\" value=\"\"/><input name=\"utm-campaign\" readonly=\"\" type=\"hidden\" value=\"\"/><input name=\"utm-content\" readonly=\"\" type=\"hidden\" value=\"\"/><input name=\"utm-term\" readonly=\"\" type=\"hidden\" value=\"\"/><input name=\"gclid\" readonly=\"\" type=\"hidden\" value=\"\"/><input name=\"fbclid\" readonly=\"\" type=\"hidden\" value=\"\"/><button class=\"w-full bg-gradient-to-r from-[#BF0025] to-[#04026C] text-white py-2.5 rounded-lg text-sm font-semibold shadow-md mt-2 hover:opacity-95 transition\" type=\"submit\"><span>Book a demo</span></button></form></div></div></div></section><section class=\"py-20 lg:py-28 bg-white dark:bg-background\"><div class=\"max-w-4xl mx-auto px-4 sm:px-6\"><div class=\"text-center mb-12\" style=\"opacity:0;transform:translateY(20px)\"><p class=\"text-xs font-semibold uppercase tracking-widest text-muted-foreground mb-4\">Direct Contact</p><h2 class=\"text-3xl sm:text-4xl font-bold text-foreground\">Reach Us <span class=\"brand\">Directly</span></h2></div><div class=\"grid grid-cols-1 sm:grid-cols-2 gap-5\"><div class=\"p-6 rounded-2xl border border-border bg-card flex items-start gap-4\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"w-10 h-10 flex-shrink-0 rounded-xl border border-border bg-muted/30 flex items-center justify-center text-muted-foreground\"></div><div><p class=\"text-[10px] font-semibold uppercase tracking-widest text-muted-foreground/50 mb-1\">Office Address</p><p class=\"text-sm font-medium text-foreground leading-relaxed\">Plot 881, Sector 40 Rd, Sector 40, Gurugram, Haryana 122003</p></div></div><div class=\"p-6 rounded-2xl border border-border bg-card flex items-start gap-4\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"w-10 h-10 flex-shrink-0 rounded-xl border border-border bg-muted/30 flex items-center justify-center text-muted-foreground\"></div><div><p class=\"text-[10px